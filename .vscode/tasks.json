{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tauri: Desktop development",
      "type": "process",
      "command": "npm",
      "args": ["--prefix", "desktop", "run", "tauri:dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "requestloom-tauri",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "endsPattern": "http://127\\.0\\.0\\.1:5173/"
        }
      }
    },
    {
      "label": "web: start dev server",
      "type": "process",
      "command": "pwsh",
      "windows": {
        "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
      },
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev.ps1",
        "start"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "requestloom-web",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "endsPattern": "Dev app started\\."
        }
      }
    }
  ]
}
